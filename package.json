{
  "name": "cal-clone",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "test:frontend": "pnpm --filter frontend test",
    "test:backend": "pnpm --filter backend test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "generate:api": "pnpm --filter typespec compile && pnpm --filter api-client generate",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "sync-versions": "node scripts/sync-versions.mjs",
    "check-versions": "node scripts/sync-versions.mjs --check",
    "test-versions": "node --test scripts/sync-versions.test.mjs",
    "check-release-please": "node scripts/check-release-please.mjs",
    "test-release-please": "node --test scripts/check-release-please.test.mjs",
    "test:golden-path": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
